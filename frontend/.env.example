# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# These are PUBLIC values safe to expose in a frontend bundle: the anon key
# only works within the RLS policies defined on the database.
# NEVER put the service_role key here or anywhere in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
